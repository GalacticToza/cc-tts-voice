  local b
  if w:sub(-3) == "IES" then
    b = try(w:sub(1, -4) .. "Y"); if b then return add(b, "Z") end
  end
  if w:sub(-2) == "ES" then
    b = try(w:sub(1, -3))
    if b and SIBILANT[b[#b].p] then return add(b, "IH", "Z") end
  end
  if w:sub(-1) == "S" and w:sub(-2) ~= "SS" then
    b = try(w:sub(1, -2))
    if b then
      local l = b[#b].p
      if SIBILANT[l] then return add(b, "IH", "Z")
      elseif VOICELESS[l] then return add(b, "S")
      else return add(b, "Z") end
    end
  end
  if w:sub(-2) == "ED" then
    b = stemOf(w:sub(1, -3))
    if b then
      local l = b[#b].p
      if l == "T" or l == "D" then return add(b, "IH", "D")
      elseif VOICELESS[l] or l == "S" or l == "SH" or l == "CH" then return add(b, "T")
      else return add(b, "D") end
    end
  end
  if w:sub(-3) == "ING" then
    b = stemOf(w:sub(1, -4)); if b then return add(b, "IH", "NG") end
  end
  if w:sub(-2) == "LY" then
    -- -ably / -ibly: "able" (EY B AX L) -> "ably" (EY B L IY)
    if w:sub(-3) == "BLY" then
      b = try(w:sub(1, -2) .. "E")
      if b and #b >= 2 and b[#b].p == "L" and b[#b - 1].p == "AX" then
        local r = copyList(b); r[#r] = nil; r[#r] = nil
        return add(r, "L", "IY")
      end
    end
    b = try(w:sub(1, -3)) or (w:sub(-3) == "ILY" and try(w:sub(1, -4) .. "Y"))
    if b then return add(b, "L", "IY") end
  end
  -- common prefixes in front of a known word
  local PREFIXES = {
    {"UN", "AH2 N"}, {"RE", "R IY2"}, {"DIS", "D IH2 S"}, {"MIS", "M IH2 S"},
    {"PRE", "P R IY2"}, {"NON", "N AA2 N"}, {"OVER", "OW2 V ER"},
    {"UNDER", "AH2 N D ER"}, {"SUPER", "S UW2 P ER"}, {"ANTI", "AE2 N T IY"},
    {"AUTO", "AO2 T OW"}, {"SUB", "S AH2 B"}, {"INTER", "IH2 N T ER"},
  }
  for _, pf in ipairs(PREFIXES) do
    local rest = w:sub(#pf[1] + 1)
    if w:sub(1, #pf[1]) == pf[1] and #rest >= 3 then
      b = try(rest)
      if b then
        local r = parseStr(pf[2])
        for _, e in ipairs(b) do r[#r + 1] = { p = e.p, s = e.s } end
        return r
      end
    end
  end
  if w:sub(-2) == "ER" then
    b = stemOf(w:sub(1, -3)); if b then return add(b, "ER") end
  end
  -- compound word: split into two known words (redstone, doorway ...)
  for i = #w - 3, 3, -1 do
    local a2, b2 = known(w:sub(1, i)), known(w:sub(i + 1))
    if a2 and b2 then
      local r = copyList(a2)
      for _, e in ipairs(b2) do
        r[#r + 1] = { p = e.p, s = (e.s == 1) and 2 or e.s }
      end
      return r
    end
  end
  return nil
end

local isVowelPh   -- defined after the phoneme table

-- Guess stress for words that came from spelling rules
local function assignStress(list, word)
  local vidx, marked = {}, false
  for i, e in ipairs(list) do
    if isVowelPh(e.p) then vidx[#vidx + 1] = i end
    if e.s and e.s > 0 then marked = true end
  end
  for _, e in ipairs(list) do e.s = e.s or 0 end
  if marked or #vidx == 0 then return list end
  if #vidx == 1 then list[vidx[1]].s = 1; return list end

  local pick
  -- -tion / -sion / -cian: stress the syllable before
  for k = #vidx, 2, -1 do
    local i = vidx[k]
    local prev = list[i - 1] and list[i - 1].p
    if (prev == "SH" or prev == "ZH") and list[i].p == "AX" then pick = vidx[k - 1]; break end
  end
  if not pick then
    if word:match("ICS?$") then pick = vidx[#vidx - 1]
    elseif (word:match("ICAL$") or word:match("ITY$") or word:match("IAL$")
            or word:match("IAN$") or word:match("IOUS$")) and #vidx >= 3 then
      pick = vidx[#vidx - 2]
    elseif #vidx == 2 and (word:match("^BE") or word:match("^RE") or word:match("^DE")
            or word:match("^PRE") or list[vidx[1]].p == "AX") then
      pick = vidx[2]
    else
      for _, i in ipairs(vidx) do
        if list[i].p ~= "AX" then pick = i; break end
      end
      pick = pick or vidx[1]
    end
  end
  list[pick].s = 1
  -- relax unstressed "uh" sounds to schwa, as real speech does
  for _, i in ipairs(vidx) do
    if i ~= pick and list[i].p == "AH" then list[i].p = "AX" end
  end
  return list
end

local function spellOut(word)
  -- spell letter by letter; the last letter carries the main stress
  local list = {}
  for ch in word:gmatch("%a") do
    for _, e in ipairs(parseStr(LETTER_NAMES[ch])) do
      e.s = (isVowelPh(e.p) and e.p ~= "AX") and 2 or 0
      list[#list + 1] = e
    end
  end
  for i = #list, 1, -1 do
    if list[i].s == 2 then list[i].s = 1; break end
  end
  return list
end

local function wordToPhonemes(word)
  local orig = word:gsub("'", "")
  word = orig:upper()
  if word == "" then return {} end
  -- short ALL-CAPS words that are not real words are acronyms: XYZ, QR, NPC
  local acronym = #orig >= 2 and #orig <= 5 and orig == word and not known(word)
  local key = acronym and ("#" .. word) or word
  if cache[key] then return cache[key] end
  local list = (not acronym) and (known(word) or morph(word))
  if list then
    list = assignStress(list, word)
  elseif acronym or #word == 1 or not word:find("[AEIOUY]") then
    list = spellOut(word)
  else
    list = assignStress(parseStr(rulesToPhonemes(word)), word)
  end
  cache[key] = list
  return list
end

