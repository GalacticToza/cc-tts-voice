local function isVowel(c) return c ~= "" and ("AEIOUY"):find(c, 1, true) ~= nil end
local function isCons(c) return c ~= "" and ("BCDFGHJKLMNPQRSTVWXZ"):find(c, 1, true) ~= nil end
local function isLetter(c) return c:match("^%a$") ~= nil end

-- match left context; pos = index of char immediately left of the match
local function matchLeft(pat, s, pos)
  for i = #pat, 1, -1 do
    local p = pat:sub(i, i)
    local c = pos >= 1 and s:sub(pos, pos) or ""
    if p == " " then
      if c ~= "" and isLetter(c) then return false end
      pos = pos - 1
    elseif p == "#" then
      if not isVowel(c) then return false end
      while pos >= 1 and isVowel(s:sub(pos, pos)) do pos = pos - 1 end
    elseif p == ":" then
      while pos >= 1 and isCons(s:sub(pos, pos)) do pos = pos - 1 end
    elseif p == "^" then
      if not isCons(c) then return false end
      pos = pos - 1
    elseif p == "." then
      if c == "" or not ("BDVGJLMNRWZ"):find(c, 1, true) then return false end
      pos = pos - 1
    elseif p == "+" then
      if c == "" or not ("EIY"):find(c, 1, true) then return false end
      pos = pos - 1
    elseif p == "&" or p == "@" then
      local two = pos >= 2 and s:sub(pos - 1, pos) or ""
      if two == "CH" or two == "SH" or (p == "@" and two == "TH") then
        pos = pos - 2
      elseif c ~= "" and ((p == "&" and ("SCGZXJ"):find(c, 1, true)) or
                          (p == "@" and ("TSRDLZNJ"):find(c, 1, true))) then
        pos = pos - 1
      else
        return false
      end
    else
      if c ~= p then return false end
      pos = pos - 1
    end
  end
  return true
end

-- match right context; pos = index of char immediately right of the match
local function matchRight(pat, s, pos)
  local n = #s
  for i = 1, #pat do
    local p = pat:sub(i, i)
    local c = pos <= n and s:sub(pos, pos) or ""
    if p == " " then
      if c ~= "" and isLetter(c) then return false end
      pos = pos + 1
    elseif p == "#" then
      if not isVowel(c) then return false end
      while pos <= n and isVowel(s:sub(pos, pos)) do pos = pos + 1 end
    elseif p == ":" then
      while pos <= n and isCons(s:sub(pos, pos)) do pos = pos + 1 end
    elseif p == "^" then
      if not isCons(c) then return false end
      pos = pos + 1
    elseif p == "." then
      if c == "" or not ("BDVGJLMNRWZ"):find(c, 1, true) then return false end
      pos = pos + 1
    elseif p == "+" then
      if c == "" or not ("EIY"):find(c, 1, true) then return false end
      pos = pos + 1
    elseif p == "%" then
      if s:sub(pos, pos + 2) == "ING" then pos = pos + 3
      elseif s:sub(pos, pos + 2) == "ELY" then pos = pos + 3
      elseif c == "E" then
        local d = s:sub(pos + 1, pos + 1)
        if d == "R" or d == "S" or d == "D" then pos = pos + 2 else pos = pos + 1 end
      else return false end
    elseif p == "&" or p == "@" then
      local two = s:sub(pos, pos + 1)
      if two == "CH" or two == "SH" or (p == "@" and two == "TH") then
        pos = pos + 2
      elseif c ~= "" and ((p == "&" and ("SCGZXJ"):find(c, 1, true)) or
                          (p == "@" and ("TSRDLZNJ"):find(c, 1, true))) then
        pos = pos + 1
      else
        return false
      end
    else
      if c ~= p then return false end
      pos = pos + 1
    end
  end
  return true
end

local function rulesToPhonemes(word)
  local s = " " .. word .. " "
  local out = {}
  local i = 2
  while i <= #s - 1 do
    local c = s:sub(i, i)
    local rules = R[c]
    local matched = false
    if rules then
      for _, r in ipairs(rules) do
        local m = r[2]
        if s:sub(i, i + #m - 1) == m and matchLeft(r[1], s, i - 1)
           and matchRight(r[3], s, i + #m) then
          if r[4] ~= "" then out[#out + 1] = r[4] end
          i = i + #m
          matched = true
          break
        end
      end
    end
    if not matched then i = i + 1 end
  end
  return table.concat(out, " ")
end

