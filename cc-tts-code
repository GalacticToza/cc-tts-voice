---------------------------------------------------------------------------
-- Yielding (CC kills programs that run more than ~7 s without yielding)
---------------------------------------------------------------------------
local yieldNow
if os and os.queueEvent and os.pullEvent then
  local lastYield = os.clock()
  yieldNow = function(force)
    if force or os.clock() - lastYield > 0.25 then
      os.queueEvent("tts_yield")
      os.pullEvent("tts_yield")
      lastYield = os.clock()
    end
  end
else
  yieldNow = function() end
end

---------------------------------------------------------------------------
-- Number and symbol expansion
---------------------------------------------------------------------------
local ones = { [0] = "zero", "one", "two", "three", "four", "five", "six",
  "seven", "eight", "nine", "ten", "eleven", "twelve", "thirteen",
  "fourteen", "fifteen", "sixteen", "seventeen", "eighteen", "nineteen" }
local tens = { "ten", "twenty", "thirty", "forty", "fifty", "sixty",
  "seventy", "eighty", "ninety" }

local function below1000(n)
  local out = {}
  if n >= 100 then
    out[#out + 1] = ones[floor(n / 100)] .. " hundred"
    n = n % 100
    if n == 0 then return table.concat(out, " ") end
  end
  if n < 20 then
    out[#out + 1] = ones[n]
  else
    local t, o = floor(n / 10), n % 10
    out[#out + 1] = tens[t] .. (o > 0 and (" " .. ones[o]) or "")
  end
  return table.concat(out, " ")
end

local function numberToWords(s)
  local int, frac = s:match("^(%d+)%.(%d+)$")
  if not int then int = s end
  local words
  if #int > 15 then
    local t = {}
    for d in int:gmatch("%d") do t[#t + 1] = ones[tonumber(d)] end
    words = table.concat(t, " ")
  else
    local n = tonumber(int)
    if n == 0 then
      words = "zero"
    else
      local parts = {}
      local scales = { "", " thousand", " million", " billion", " trillion" }
      local i = 1
      while n > 0 do
        local c = n % 1000
        if c > 0 then table.insert(parts, 1, below1000(c) .. scales[i]) end
        n = floor(n / 1000)
        i = i + 1
      end
      words = table.concat(parts, " ")
    end
  end
  if frac then
    local t = {}
    for d in frac:gmatch("%d") do t[#t + 1] = ones[tonumber(d)] end
    words = words .. " point " .. table.concat(t, " ")
  end
  return words
end

local function normalizeText(text)
  text = " " .. text .. " "
  local k
  repeat text, k = text:gsub("(%d),(%d%d%d)", "%1%2") until k == 0  -- 1,000 -> 1000
  -- initials like J.K. or U.S.A. become one spelled-out acronym
  text = text:gsub("%f[%a]%u%.[%u%.]+", function(m)
    if m:gsub("%u%.", "") == "" then return (m:gsub("%.", "")) end
  end)
  text = text:gsub("(%d+):00", "%1 o'clock")             -- 7:00 -> seven o'clock
  text = text:gsub("(%d+):0(%d)", "%1 oh %2")            -- 7:05 -> seven oh five
  text = text:gsub("(%d+):(%d%d)", "%1 %2")              -- 7:30 -> seven thirty
  text = text:gsub("(%d+)%%", "%1 percent")
  text = text:gsub("%$(%d+%.?%d*)", "%1 dollars")
  text = text:gsub("(%d+%.%d+)", function(n) return " " .. numberToWords(n) .. " " end)
  text = text:gsub("(%d+)", function(n) return " " .. numberToWords(n) .. " " end)
  text = text:gsub("&", " and "):gsub("@", " at "):gsub("%+", " plus ")
  text = text:gsub("=", " equals "):gsub("#", " number ")
  text = text:gsub("(%a)%-(%a)", "%1 %2")
  return text
end

