local CMU, CMU_PH, CMU_ST = nil, {}, {}
local function loadCMU()
  CMU = {}
  local i = 0
  for ph in CMU_KEY:gmatch("%S+") do
    i = i + 1
    CMU_PH[CMU_SYMS:sub(i, i)] = ph
  end
  CMU_ST[CMU_SYMS:sub(i + 1, i + 1)] = 1
  CMU_ST[CMU_SYMS:sub(i + 2, i + 2)] = 2
  local n = 0
  for w, c in CMU_DATA:gmatch("(%l+)([^%l]+)") do
    CMU[w] = c
    n = n + 1
    if n % 1500 == 0 then yieldNow() end
  end
end

local function cmuLookup(w)
  if not CMU then loadCMU() end
  local c = CMU[w:lower()]
  if not c then return nil end
  local list = {}
  for i = 1, #c do
    local ch = c:sub(i, i)
    local st = CMU_ST[ch]
    if st then
      list[#list].s = st
    else
      list[#list + 1] = { p = CMU_PH[ch], s = 0 }
    end
  end
  return list
end

-- "HH AX L OW1" -> { {p="HH"}, {p="AX"}, {p="L"}, {p="OW", s=1} }
local function parseStr(str)
  local list = {}
  for tok in str:gmatch("%S+") do
    local ph, st = tok:match("^(%a+)(%d?)$")
    if ph then list[#list + 1] = { p = ph, s = (st ~= "") and tonumber(st) or nil } end
  end
  return list
end

local function copyList(l)
  local r = {}
  for i, e in ipairs(l) do r[i] = { p = e.p, s = e.s } end
  return r
end

local function known(w)
  if USER[w] then return parseStr(USER[w]) end
  local c = cmuLookup(w)
  if c then return c end
  if DICT[w] then return parseStr(DICT[w]) end
  return nil
end

