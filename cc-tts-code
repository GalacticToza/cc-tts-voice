local function runGui()
  ---------------------------------------------------------------------------
  -- Checks
  ---------------------------------------------------------------------------
  local W, H = term.getSize()
  if not term.isColour() or W < 51 or H < 19 then
    return false   -- caller falls back to the plain text prompt
  end

  ---------------------------------------------------------------------------
  -- Palette: a restrained navy / slate / gold theme
  ---------------------------------------------------------------------------
  local C = {
    bg     = colours.black,      -- page background
    panel  = colours.grey,       -- panel surface
    field  = colours.cyan,       -- inset input field
    header = colours.blue,       -- title bar
    btn    = colours.purple,     -- neutral button
    accent = colours.lightBlue,  -- bars, selection
    gold   = colours.yellow,     -- rules and headings
    text   = colours.white,
    muted  = colours.lightGrey,
    go     = colours.green,
    stop   = colours.red,
    warn   = colours.orange,
  }
  local PALETTE = {
    [colours.black]     = 0x10161F,
    [colours.grey]      = 0x1B2533,
    [colours.cyan]      = 0x0A0F16,
    [colours.blue]      = 0x22406A,
    [colours.purple]    = 0x2E3D52,
    [colours.lightBlue] = 0x5B8FC7,
    [colours.yellow]    = 0xC2A15A,
    [colours.white]     = 0xE6EAF0,
    [colours.lightGrey] = 0x8793A3,
    [colours.green]     = 0x2E7A50,
    [colours.red]       = 0x8E3B3B,
    [colours.orange]    = 0xC98A45,
  }
  local function applyPalette()
    for c, hex in pairs(PALETTE) do term.setPaletteColour(c, hex) end
  end
  local function restorePalette()
    for c in pairs(PALETTE) do term.setPaletteColour(c, term.nativePaletteColour(c)) end
  end

  ---------------------------------------------------------------------------
  -- State and persistence
  ---------------------------------------------------------------------------
  local SAVE_PATH = "/.ttsgui_settings"

  -- presets are relative to the selected voice's natural pitch
  local PRESETS = {
    { name = "Standard",  pitch = 1.00, speed = 1.0 },
    { name = "Deep",      pitch = 0.80, speed = 0.92 },
    { name = "Bright",    pitch = 1.22, speed = 1.05 },
    { name = "Announcer", pitch = 0.92, speed = 0.82 },
    { name = "Brisk",     pitch = 1.05, speed = 1.35 },
  }

  local HAS_NATURAL = tts.hasNatural()
  local state = {
    voice = HAS_NATURAL and "natural" or "male",
    pitch = tts.voicePitch(HAS_NATURAL and "natural" or "male"),
    speed = 1.0, volume = 1.0, preset = 1,
  }

  local function load()
    if not fs.exists(SAVE_PATH) then return end
    local h = fs.open(SAVE_PATH, "r")
    if not h then return end
    local data = textutils.unserialize(h.readAll() or "")
    h.close()
    if type(data) == "table" then
      for _, k in ipairs({ "voice", "pitch", "speed", "volume", "preset" }) do
        if data[k] ~= nil then state[k] = data[k] end
      end
    end
    if state.voice == "natural" and not HAS_NATURAL then
      state.voice = "male"; state.pitch = tts.voicePitch("male")
    end
  end

  local function save()
    local h = fs.open(SAVE_PATH, "w")
    if h then h.write(textutils.serialize(state)); h.close() end
  end

  load()

  local MAX_LEN = 500
  local message, cursor = "", 0      -- cursor = chars before the caret
  local fieldTop = 0                 -- first visible wrapped line
  local status, statusCol, statusTimer = "Ready", C.muted, nil
  local speakers = {}

  local function refreshSpeakers()
    speakers = { peripheral.find("speaker") }
  end
  refreshSpeakers()

  local function setStatus(msg, col, hold)
    status, statusCol = msg, col or C.muted
    if statusTimer then os.cancelTimer(statusTimer) end
    statusTimer = hold and os.startTimer(hold) or nil
  end

  ---------------------------------------------------------------------------
  -- Speech worker (runs as a coroutine so the UI stays responsive)
  ---------------------------------------------------------------------------
  local worker, workerFilter = nil, nil

  local function resumeWorker(...)
    local ok, res = coroutine.resume(worker, ...)
    if not ok then
      worker = nil
      setStatus("Error: " .. tostring(res), C.stop, 6)
    elseif coroutine.status(worker) == "dead" then
      worker = nil
      setStatus("Finished speaking.", C.muted, 3)
    else
      workerFilter = res
    end
  end

  local function stopSpeech(quiet)
    if worker then worker = nil end
    for _, sp in ipairs(speakers) do pcall(sp.stop) end
    if not quiet then setStatus("Playback stopped.", C.warn, 3) end
  end

  local function speak(text)
    text = text and text:gsub("^%s+", ""):gsub("%s+$", "") or ""
    if text == "" then setStatus("Nothing to say. Type a message first.", C.warn, 3); return end
    refreshSpeakers()
    if #speakers == 0 then
      setStatus("No speaker connected. Attach one to this computer.", C.stop, 5)
      return
    end
    stopSpeech(true)
    local opts = { voice = state.voice, pitch = state.pitch, speed = state.speed,
                   volume = state.volume, speakers = speakers }
    worker = coroutine.create(function() tts.say(text, opts) end)
    workerFilter = nil
    setStatus("Speaking...", C.accent)
    resumeWorker()
  end

  ---------------------------------------------------------------------------
  -- Drawing helpers
  ---------------------------------------------------------------------------
  local hits = {}

  local function at(x, y, s, fg, bg)
    term.setCursorPos(x, y)
    if bg then term.setBackgroundColour(bg) end
    if fg then term.setTextColour(fg) end
    term.write(s)
  end

  local function fill(x, y, w, h, bg)
    term.setBackgroundColour(bg)
    local line = (" "):rep(w)
    for i = 0, h - 1 do term.setCursorPos(x, y + i); term.write(line) end
  end

  local function hit(id, x, y, w, data)
    hits[#hits + 1] = { id = id, x = x, y = y, w = w, data = data }
  end

  local function button(id, x, y, label, bg, fg)
    local s = " " .. label .. " "
    at(x, y, s, fg or C.text, bg or C.btn)
    hit(id, x, y, #s)
    return #s
  end

  local function fit(s, w)
    if #s <= w then return s .. (" "):rep(w - #s) end
    return s:sub(1, w - 3) .. "..."
  end

  local RULE = "\140"   -- thin horizontal line (teletext character)

  ---------------------------------------------------------------------------
  -- Layout
  ---------------------------------------------------------------------------
  local FX, FY, FW, FH = 4, 4, W - 7, 5        -- message text area (inside box)
  local MY2 = FY + FH + 1                      -- message button row
  local VY = MY2 + 2                           -- voice panel top
  local LX, LW = 3, 22                         -- left column
  local RX, RW = W - 24, 23                    -- right column

  local RANGES = {
    pitch  = { min = 60,  max = 300, step = 5,    fmt = function(v) return ("%d Hz"):format(v) end },
    speed  = { min = 0.5, max = 2.0, step = 0.1,  fmt = function(v) return ("%.1fx"):format(v) end },
    volume = { min = 0,   max = 3.0, step = 0.25, fmt = function(v) return ("%d%%"):format(math.floor(v / 3 * 100 + 0.5)) end },
  }

  local VOICES = {
    { id = "natural", label = "Natural", icon = "\12 Natural" },
    { id = "male",    label = "Male",    icon = "\11 Male" },
    { id = "female",  label = "Female",  icon = "\12 Female" },
  }
  local function voiceInfo(id)
    for _, v in ipairs(VOICES) do if v.id == id then return v end end
    return VOICES[2]
  end

  ---------------------------------------------------------------------------
  -- Sections
  ---------------------------------------------------------------------------
  local function drawHeader()
    fill(1, 1, W, 1, C.header)
    at(2, 1, "\4 ", C.gold, C.header)
    at(4, 1, "SPEECH SYNTHESIS CONSOLE", C.text, C.header)
    local x = W - 6
    button("exit", x, 1, "Exit", C.stop)
    -- one-click voice switch (also: Tab key)
    local label = voiceInfo(state.voice).icon
    button("vtoggle", x - #label - 3, 1, label, C.accent, C.bg)
    at(1, 2, ("\131"):rep(W), C.gold, C.bg)
  end

  -- Word-wrap the message; each line = { start = index of first char (0-based), text }
  local function wrapLines()
    local lines, pos, n = {}, 0, #message
    repeat
      local len = n - pos
      if len > FW then
        local chunk = message:sub(pos + 1, pos + FW)
        local brk = chunk:match("^.*() ")        -- last space in the chunk
        len = (brk and brk > 1) and brk or FW
      end
      lines[#lines + 1] = { start = pos, text = message:sub(pos + 1, pos + len) }
      pos = pos + len
    until pos >= n
    if #message > 0 and #lines[#lines].text >= FW then
      lines[#lines + 1] = { start = n, text = "" }
    end
    return lines
  end

  local function cursorLine(lines)
    local li = 1
    for i, l in ipairs(lines) do if l.start <= cursor then li = i end end
    return li, cursor - lines[li].start
  end

  local function drawMessage()
    fill(2, 3, W - 2, MY2 - 2, C.panel)
    at(3, 3, "MESSAGE", C.gold, C.panel)
    local count = ("%d / %d"):format(#message, MAX_LEN)
    at(W - 1 - #count, 3, count, C.muted, C.panel)

    fill(FX - 1, FY, FW + 2, FH, C.field)
    for i = 0, FH - 1 do hit("field", FX - 1, FY + i, FW + 2) end
    if message == "" then
      at(FX, FY, "Type a message and press Enter to speak.", C.muted, C.field)
    else
      local lines = wrapLines()
      local curLine = cursorLine(lines) - 1
      if curLine < fieldTop then fieldTop = curLine end
      if curLine > fieldTop + FH - 1 then fieldTop = curLine - FH + 1 end
      for i = 0, FH - 1 do
        local l = lines[fieldTop + i + 1]
        if l then at(FX, FY + i, l.text, C.text, C.field) end
      end
    end

    -- buttons, right aligned
    local labels = {
      { "speak", "\16 Speak", C.go },
      { "stop",  "Stop",      C.stop },
      { "clear", "Clear",     C.btn },
    }
    local x = W - 1
    for _, b in ipairs(labels) do
      x = x - (#b[2] + 2)
      button(b[1], x, MY2, b[2], b[3])
      x = x - 1
    end
    at(3, MY2, "Enter=speak Tab=voice", C.muted, C.panel)
  end

  local function drawSlider(key, label, x, y, w)
    local r = RANGES[key]
    local v = state[key]
    local val = r.fmt(v)
    at(x, y, label, C.text, C.panel)
    at(x + w - #val, y, val, C.accent, C.panel)
    button(key .. "-", x, y + 1, "-", C.btn)
    local bx, bw = x + 3, w - 6
    local frac = (v - r.min) / (r.max - r.min)
    local filled = math.floor(frac * bw + 0.5)
    for i = 0, bw - 1 do
      at(bx + i, y + 1, " ", nil, i < filled and C.accent or C.field)
    end
    hit("bar", bx, y + 1, bw, key)
    button(key .. "+", bx + bw, y + 1, "+", C.btn)
  end

  local function drawVoice()
    fill(2, VY, W - 2, H - 2 - VY, C.panel)
    at(3, VY, "VOICE", C.gold, C.panel)
    local p = PRESETS[state.preset] or PRESETS[1]
    local plabel = "Preset: " .. p.name .. " \16"
    button("preset", W - 2 - #plabel - 1, VY, plabel, C.btn)

    drawSlider("pitch", "Pitch", LX, VY + 1, LW)
    drawSlider("speed", "Speed", LX, VY + 3, LW)
    drawSlider("volume", "Volume", RX, VY + 1, RW)

    -- three-way voice switch
    at(RX, VY + 3, "Voice", C.text, C.panel)
    local x = RX
    for _, v in ipairs(VOICES) do
      local on = state.voice == v.id
      local unavailable = v.id == "natural" and not HAS_NATURAL
      local fg = on and C.bg or (unavailable and C.panel or C.muted)
      if unavailable then fg = C.muted end
      x = x + button("v_" .. v.id, x, VY + 4, v.label, on and C.accent or C.btn, fg)
    end
  end

  local function drawStatus()
    fill(1, H - 1, W, 1, C.bg)
    at(1, H - 1, RULE:rep(W), C.gold, C.bg)
    fill(1, H, W, 1, C.panel)
    local spk = #speakers == 0 and "No speaker" or
                (#speakers == 1 and "1 speaker" or (#speakers .. " speakers"))
    local right = spk .. " "
    at(2, H, "\7 ", statusCol, C.panel)
    at(4, H, fit(status, W - 6 - #right), statusCol == C.muted and C.text or statusCol, C.panel)
    at(W - #right + 1, H, right, #speakers == 0 and C.stop or C.muted, C.panel)
  end

  local function draw()
    hits = {}
    term.setCursorBlink(false)
    term.setBackgroundColour(C.bg)
    term.clear()
    drawHeader()
    drawMessage()
    drawVoice()
    drawStatus()
    -- caret
    local li, col = cursorLine(wrapLines())
    term.setCursorPos(FX + math.min(col, FW - 1), FY + li - 1 - fieldTop)
    term.setTextColour(C.gold)
    term.setBackgroundColour(C.field)
    term.setCursorBlink(true)
  end

  ---------------------------------------------------------------------------
  -- Actions
  ---------------------------------------------------------------------------
  local function clamp(key, v)
    local r = RANGES[key]
    v = math.max(r.min, math.min(r.max, v))
    return math.floor(v / r.step + 0.5) * r.step
  end

  local function insert(s)
    s = s:gsub("[\r\n\t]", " ")
    local room = MAX_LEN - #message
    if room <= 0 then return end
    s = s:sub(1, room)
    message = message:sub(1, cursor) .. s .. message:sub(cursor + 1)
    cursor = cursor + #s
  end

  local actions = {}
  actions.exit   = function() return "exit" end
  actions.speak  = function() speak(message) end
  actions.stop   = function() stopSpeech() end
  actions.clear  = function() message, cursor, fieldTop = "", 0, 0 end
  local function applyPreset()
    local p = PRESETS[state.preset] or PRESETS[1]
    state.pitch = clamp("pitch", tts.voicePitch(state.voice) * p.pitch)
    state.speed = clamp("speed", p.speed)
    save()
  end
  actions.preset = function()
    state.preset = (state.preset % #PRESETS) + 1
    applyPreset()
    setStatus("Voice preset: " .. PRESETS[state.preset].name, C.muted, 3)
  end
  local function setVoice(v)
    if v == "natural" and not HAS_NATURAL then
      setStatus(tts.voiceProblem and ("Natural voice: " .. tts.voiceProblem) or "Natural voice: no voice pieces found.", C.warn, 6)
      return
    end
    if state.voice == v then return end
    state.voice = v
    applyPreset()
    setStatus("Voice: " .. voiceInfo(v).label, C.muted, 3)
  end
  actions.vtoggle = function()
    local order = HAS_NATURAL and { "natural", "male", "female" } or { "male", "female" }
    local nextv = order[1]
    for i, id in ipairs(order) do
      if id == state.voice then nextv = order[i % #order + 1] end
    end
    setVoice(nextv)
  end
  for _, v in ipairs(VOICES) do
    actions["v_" .. v.id] = function() setVoice(v.id) end
  end
  actions.field  = function(_, x, y)
    local lines = wrapLines()
    local l = lines[y - FY + fieldTop + 1] or lines[#lines]
    local col = math.max(0, math.min(#l.text, x - FX))
    cursor = math.max(0, math.min(#message, l.start + col))
  end
  actions.bar    = function(key, x)
    local r = RANGES[key]
    local h
    for _, hh in ipairs(hits) do if hh.id == "bar" and hh.data == key then h = hh end end
    if not h then return end
    local frac = (x - h.x + 1) / h.w
    state[key] = clamp(key, r.min + frac * (r.max - r.min))
    save()
  end
  for _, key in ipairs({ "pitch", "speed", "volume" }) do
    actions[key .. "-"] = function() state[key] = clamp(key, state[key] - RANGES[key].step); save() end
    actions[key .. "+"] = function() state[key] = clamp(key, state[key] + RANGES[key].step); save() end
  end

  local function click(x, y)
    for i = #hits, 1, -1 do
      local h = hits[i]
      if y == h.y and x >= h.x and x < h.x + h.w then
        local fn = actions[h.id]
        if fn then return fn(h.data, x, y) end
        return
      end
    end
  end

  ---------------------------------------------------------------------------
  -- Main loop
  ---------------------------------------------------------------------------
  local function main()
    applyPalette()
    draw()
    while true do
      local ev = table.pack(os.pullEventRaw())
      local name = ev[1]

      if worker and (workerFilter == nil or workerFilter == name or name == "terminate") then
        resumeWorker(table.unpack(ev, 1, ev.n))
      end

      if name == "terminate" then
        break
      elseif name == "mouse_click" then
        if click(ev[3], ev[4]) == "exit" then break end
      elseif name == "mouse_drag" then
        for _, h in ipairs(hits) do
          if h.id == "bar" and ev[4] == h.y and ev[3] >= h.x - 1 and ev[3] <= h.x + h.w then
            actions.bar(h.data, math.max(h.x, math.min(h.x + h.w - 1, ev[3])))
          end
        end
      elseif name == "char" or name == "paste" then
        insert(ev[2])
      elseif name == "key" then
        local k = ev[2]
        if k == keys.enter or k == keys.numPadEnter then speak(message)
        elseif k == keys.tab then actions.vtoggle()
        elseif k == keys.backspace and cursor > 0 then
          message = message:sub(1, cursor - 1) .. message:sub(cursor + 1); cursor = cursor - 1
        elseif k == keys.delete and cursor < #message then
          message = message:sub(1, cursor) .. message:sub(cursor + 2)
        elseif k == keys.left then cursor = math.max(0, cursor - 1)
        elseif k == keys.right then cursor = math.min(#message, cursor + 1)
        elseif k == keys.home then cursor = 0
        elseif k == keys["end"] then cursor = #message
        elseif k == keys.up or k == keys.down then
          local lines = wrapLines()
          local li, col = cursorLine(lines)
          local t = lines[li + (k == keys.up and -1 or 1)]
          if t then cursor = t.start + math.min(col, #t.text) end
        end
      elseif name == "timer" and ev[2] == statusTimer then
        statusTimer = nil
        if not worker then status, statusCol = "Ready", C.muted end
      elseif name == "peripheral" or name == "peripheral_detach" then
        refreshSpeakers()
      elseif name == "term_resize" then
        W, H = term.getSize()
      end
      draw()
    end
  end

  local ok, err = pcall(main)
  stopSpeech(true)
  restorePalette()
  term.setBackgroundColour(colours.black)
  term.setTextColour(colours.white)
  term.setCursorBlink(false)
  term.clear()
  term.setCursorPos(1, 1)
  if not ok then printError(err) else print("Speech console closed.") end
  return true

end

--- True if the natural voice file (tts_voice.dat) is available.
function tts.hasNatural() return loadNatural() ~= nil end

--- Natural pitch (Hz) of a voice: "natural", "male" or "female".
function tts.voicePitch(name)
  if name == "natural" and loadNatural() then return (VDB or natural).meta.f0 end
  return (tts.voices[name] or tts.voices.male).pitch
end

--- Open the graphical console. Returns false if the screen can't show it.
function tts.gui() return runGui() end

---------------------------------------------------------------------------
-- Command-line use
---------------------------------------------------------------------------
local args = { ... }
local function runningAsProgram()
  if not shell or not shell.getRunningProgram then return false end
  local running = (shell.getRunningProgram() or ""):gsub("^/", "")
  local info = debug and debug.getinfo and debug.getinfo(1, "S")
  local src = info and info.source or ""
  if src:sub(1, 1) == "@" then
    return src:sub(2):gsub("^/", "") == running
  end
  return true
end

local function textPrompt(opt)
  print("CC TTS - type text and press Enter. Empty line quits.")
  while true do
    write("> ")
    local line = read()
    if not line or line == "" then break end
    local ok, err = pcall(tts.say, line, opt)
    if not ok then printError(err) end
  end
end

local function yesNo(question)
  write(question .. " (y/n) ")
  local a = read()
  return a and a:lower():sub(1, 1) == "y"
end

if runningAsProgram() and args[1] == "url" then
  if args[2] == "none" then
    tts.setVoiceUrl(nil); print("Voice link removed.")
  elseif args[2] then
    local u = tts.setVoiceUrl(args[2])
    print("Voice link saved:")
    print("  " .. u)
    print("Testing download...")
    tts.voiceUrl = u
    local ok, data, why = pcall(gatherDB)
    if ok and data then print(("OK - voice downloaded (%d KB)."):format(math.floor(#data / 1024)))
    else printError("Problem: " .. tostring(ok and why or data)) end
  elseif tts.getVoiceUrl() then
    print("Current voice link:")
    print("  " .. tts.getVoiceUrl())
    print("Change it with:  tts url <link>    Remove it with:  tts url none")
  else
    print("No voice link set. Use:  tts url <link to tts_voice_big.dat>")
  end
  return tts
end

if runningAsProgram() then
  local opt, words, file, textMode = {}, {}, nil, false
  local i = 1
  while i <= #args do
    local a = args[i]
    if a == "-p" then opt.pitch = tonumber(args[i + 1]); i = i + 2
    elseif a == "-s" then opt.speed = tonumber(args[i + 1]); i = i + 2
    elseif a == "-v" then opt.volume = tonumber(args[i + 1]); i = i + 2
    elseif a == "-f" then file = args[i + 1]; i = i + 2
    elseif a == "-t" then textMode = true; i = i + 1
    elseif a == "--female" or a == "-F" then opt.voice = "female"; i = i + 1
    elseif a == "--male" or a == "-M" then opt.voice = "male"; i = i + 1
    elseif a == "--natural" or a == "-N" then opt.voice = "natural"; i = i + 1
    elseif a == "-h" or a == "--help" then
      print("Usage: tts [--natural|--male|--female] [-p pitch] [-s speed] [-v volume]")
      print("           [-f file] [-t] [text...]")
      print("No text opens the console (-t for a plain prompt).")
      print("tts url <link>   set the web link of the large natural voice")
      return tts
    else words[#words + 1] = a; i = i + 1 end
  end
  if file then
    local path = shell.resolve(file)
    local h = fs.open(path, "r")
    if not h then printError("Cannot open " .. path); return tts end
    local content = h.readAll(); h.close()
    tts.say(content, opt)
  elseif #words > 0 then
    tts.say(table.concat(words, " "), opt)
  elseif textMode or not runGui() then
    textPrompt(opt)
  end
end

return tts
